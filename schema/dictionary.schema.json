{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/jonathanselby/data-dictionary-first/schema/dictionary.schema.json",
  "title": "Data Dictionary First dictionary",
  "description": "Machine-readable contract for the governed dictionary format used by ddcheck.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "version",
    "data_owner",
    "data_steward",
    "source_of_truth",
    "grain",
    "unknown_fields",
    "fields"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "data_owner": {
      "type": "string",
      "minLength": 1
    },
    "data_steward": {
      "type": "string",
      "minLength": 1
    },
    "source_of_truth": {
      "type": "string",
      "minLength": 1
    },
    "grain": {
      "type": "string",
      "minLength": 1
    },
    "unknown_fields": {
      "type": "string",
      "enum": ["allow", "reject"]
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/field"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "definition", "type", "required", "nullable"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "definition": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "enum": ["string", "integer", "number", "boolean", "object", "array"]
        },
        "required": {
          "type": "boolean"
        },
        "nullable": {
          "type": "boolean"
        },
        "allowed_values": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "source": {
          "type": "string"
        },
        "example": true
      },
      "allOf": [
        {
          "if": {
            "required": ["allowed_values"]
          },
          "then": {
            "properties": {
              "type": {
                "const": "string"
              }
            }
          }
        }
      ]
    }
  }
}
